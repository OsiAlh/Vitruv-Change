module tools.vitruv.change.maturity.model

import org.eclipse.emf.mwe2.ecore.EcoreGenerator
import org.eclipse.emf.mwe.utils.StandaloneSetup

var workspaceRoot = ".."

Workflow {

    bean = StandaloneSetup {
        scanClassPath = true
        platformUri = workspaceRoot
    }

    component = EcoreGenerator {
        genModel = "platform:/resource/tools.vitruv.change.maturity.model/src/main/maturity.genmodel"
        srcPath = "platform:/resource/tools.vitruv.change.maturity.model/target/generated-sources/ecore"
        generateCustomClasses = false
    }

}
