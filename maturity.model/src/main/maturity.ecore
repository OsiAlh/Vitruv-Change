<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="maturity" nsURI="http://www.example.org/maturity" nsPrefix="maturity">
  <eClassifiers xsi:type="ecore:EEnum" name="MaturityLevelEnum">
    <eLiterals name="DRAFT"/>
    <eLiterals name="REVIEWED" value="1"/>
    <eLiterals name="FINAL" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MaturityChange">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="oldLevel" lowerBound="1"
        eType="#//MaturityLevelEnum"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="newLevel" lowerBound="1"
        eType="#//MaturityLevelEnum"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MaturityState">
    <eStructuralFeatures xsi:type="ecore:EReference" name="history" upperBound="-1"
        eType="#//MaturityChange" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
  </eClassifiers>
</ecore:EPackage>
